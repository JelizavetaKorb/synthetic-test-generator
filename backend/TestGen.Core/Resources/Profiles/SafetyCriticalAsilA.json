{
  "profileId": "safety-critical-asil-a",
  "name": "Safety Critical — ASIL A",
  "description": "ASIL A baseline safety scenario. Light formal-evidence requirements: a hazard reference and at least one major-severity assertion covering the safety goal.",
  "defaultParameters": {
    "priority": "medium",
    "version": "1.0",

    "initialConditions.ambientTemperatureC": 20,
    "initialConditions.batteryVoltageV": 12.6,
    "initialConditions.engineState": "RUNNING",
    "initialConditions.fuelLevelPercent": 80,
    "initialConditions.vehicleSpeedMps": 10.0,
    "initialConditions.gearPosition": "D",
    "initialConditions.ignitionKey": "ON",
    "initialConditions.ambientHumidityPct": 50,
    "initialConditions.gpsFixQuality": "GOOD",
    "initialConditions.localizationErrorM": 0.1,

    "ecuId": "BODY-ECU-001",
    "ecuMode": "NORMAL",
    "ecuTemperatureC": 25,
    "ecuPowerState": "ON",
    "hwInterface": ["CAN"],
    "diagnosticSession": "NONE",

    "targetExecution": "SIL",

    "asilLevel": "A",
    "hazardId": "HAZ-A-001",
    "safetyGoal": "Maintain warning-system availability during normal operation",
    "safety.riskWeight": 0.25,
    "safety.recoveryBehaviourExpected": true,

    "assertions[0].id": "A1",
    "assertions[0].type": "metric",
    "assertions[0].expr": "warning_indicator_available == true",
    "assertions[0].severity": "major",

    "bus.busName": "BodyCAN",
    "bus.busType": "CAN",
    "bus.bitrateKbps": 500,
    "bus.busLoadPct": 20,
    "bus.messageJitterMs": 1,

    "testDurationMs": 30000,
    "timeResolutionMs": 10,
    "timing.repetitions": 1,
    "timing.interTestDelayMs": 1000,

    "reporting.format": "JSON",
    "reporting.logLevel": "INFO",
    "reporting.telemetryFrequencyHz": 20,
    "reporting.traceCapture": true,
    "reporting.saveArtifacts": true,

    "execution.targetRunner": "SIL_runner",
    "execution.timeoutMs": 120000
  },
  "lockedParameters": [
    "asilLevel"
  ],
  "recommendedAssertions": [
    "warning_indicator_available",
    "no_safety_goal_violation",
    "dtc_logged_on_safety_violation"
  ]
}
